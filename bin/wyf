#!/usr/bin/env php
<?php


require_once 'vendor/autoload.php';

use clearice\argparser\ArgumentParser;

$parser = new ArgumentParser();

$parser->addCommand([
    'name' => 'build',
    'help' => 'Build assets for the WYF framework',
]);

$parser->addCommand([
    'name' => 'watch',
    'help' => 'Watch and rebuild assets on change',
]);

$parser->enableHelp(
    "WYF Command Line Tool\nBuild and watch assets for the WYF framework.",
    "",
    "wyf"
);

$options = $parser->parse();

$command = $options['__command'] ?? null;

function runWebpack(array $args = []): void
{
    $webpackBin = './node_modules/.bin/webpack';
    $bin = file_exists($webpackBin) ? escapeshellarg($webpackBin) : 'npx webpack';
    $cmd = sprintf('%s %s', $bin, implode(' ', array_map('escapeshellarg', $args)));
    passthru($cmd, $returnCode);
    exit($returnCode);
}

switch ($command) {
    case 'build':
        runWebpack();
        break;

    case 'watch':
        runWebpack(['--watch']);
        break;

    default:
        echo $parser->getHelpMessage();
        exit(1);
}

