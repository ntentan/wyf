#!/usr/bin/env php
<?php

$autoloadFiles = [
    'vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../vendor/autoload.php',
];

$autoloadFound = false;
foreach ($autoloadFiles as $file) {
    if (file_exists($file)) {
        require_once $file;
        $autoloadFound = true;
        break;
    }
}

if (!$autoloadFound) {
    fwrite(STDERR, "Could not find Composer autoload.php\n");
    exit(1);
}

use clearice\argparser\ArgumentParser;

$parser = new ArgumentParser();

$parser->addCommand([
    'name' => 'build',
    'help' => 'Build assets for the WYF framework',
]);

$parser->addCommand([
    'name' => 'watch',
    'help' => 'Watch and rebuild assets on change',
]);

$parser->addCommand([
    'name' => 'init',
    'help' => 'Initialize package.json and webpack.config.js in the current directory',
]);

$parser->enableHelp(
    "WYF Command Line Tool\nBuild and watch assets for the WYF framework.",
    "",
    "wyf"
);

$options = $parser->parse();

$command = $options['__command'] ?? null;

function runWebpack(array $args = []): void
{
    $webpackBin = './node_modules/.bin/webpack';
    $bin = file_exists($webpackBin) ? escapeshellarg($webpackBin) : 'npx webpack';
    $cmd = sprintf('%s %s', $bin, implode(' ', array_map('escapeshellarg', $args)));
    passthru($cmd, $returnCode);
    exit($returnCode);
}

function initPackageJson(): bool
{
    $targetFile = 'package.json';
    if (file_exists($targetFile)) {
        echo "A package.json file already exists in the current directory.\n";
        return false;
    }

    $name = basename(getcwd());
    $description = '';
    $author = '';
    $license = 'ISC';

    if (file_exists('composer.json')) {
        $composer = json_decode(file_get_contents('composer.json'), true);
        if (is_array($composer)) {
            if (!empty($composer['name'])) {
                $parts = explode('/', $composer['name']);
                $name = end($parts);
            }
            if (!empty($composer['description'])) {
                $description = $composer['description'];
            }
            if (!empty($composer['license'])) {
                $license = $composer['license'];
            }
            if (!empty($composer['authors'][0]['name'])) {
                $author = $composer['authors'][0]['name'];
            }
        }
    }

    $packageData = [
        'name' => $name,
        'version' => '1.0.0',
        'description' => $description,
    ];

    $gitUrl = trim((string) @shell_exec('git config --get remote.origin.url 2>/dev/null'));
    if ($gitUrl !== '') {
        $packageData['repository'] = [
            'type' => 'git',
            'url' => $gitUrl,
        ];
    }

    $packageData['license'] = $license;
    $packageData['author'] = $author;
    $packageData['type'] = 'module';
    $packageData['main'] = 'index.js';
    $packageData['scripts'] = [
        'build' => 'webpack',
        'watch' => 'webpack --watch',
        'test' => 'echo "Error: no test specified" && exit 1',
    ];
    $packageData['devDependencies'] = [
        'css-loader' => '^7.1.5',
        'mini-css-extract-plugin' => '^2.10.2',
        'sass' => '^1.107.1',
        'sass-loader' => '^17.1.0',
        'webpack-cli' => '^7.3.1',
    ];

    $content = json_encode($packageData, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
    if (file_put_contents($targetFile, $content) === false) {
        echo "Failed to create package.json\n";
        return false;
    }

    echo "Created package.json\n";
    return true;
}

function getWebpackConfigTemplatePath(): ?string
{
    $candidates = [
        dirname(__DIR__) . '/code_templates/webpack.config.js',
        dirname(__DIR__) . '/templates/webpack.config.js',
        dirname(__DIR__) . '/resources/webpack.config.js',
    ];

    foreach ($candidates as $candidate) {
        if (file_exists($candidate)) {
            return $candidate;
        }
    }

    return null;
}

function initWebpackConfig(): bool
{
    $targetFile = 'webpack.config.js';
    if (file_exists($targetFile)) {
        echo "A webpack.config.js file already exists in the current directory.\n";
        return false;
    }

    $templateFile = getWebpackConfigTemplatePath();
    if ($templateFile === null) {
        fwrite(STDERR, "Could not find webpack.config.js template file\n");
        return false;
    }

    if (!copy($templateFile, $targetFile)) {
        echo "Failed to create webpack.config.js\n";
        return false;
    }

    echo "Created webpack.config.js\n";
    return true;
}

function init(): void
{
    $createdPackageJson = initPackageJson();
    $createdWebpackConfig = initWebpackConfig();

    if (!$createdPackageJson && !$createdWebpackConfig) {
        exit(1);
    }
    exit(0);
}

switch ($command) {
    case 'build':
        runWebpack();
        break;

    case 'watch':
        runWebpack(['--watch']);
        break;

    case 'init':
        init();
        break;

    default:
        echo $parser->getHelpMessage();
        exit(1);
}
